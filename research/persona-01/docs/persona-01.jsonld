  "creativeWorkStatus": "Proposed; not run",
  "subjectOf": {
    "@type": "Dataset",
    "name": "PERSONA-01 method artefacts",
    "description": "Protocol, pilot method, scoring rubric criteria and EffectLog run-record schema. Contains no tasks, answers or results.",
    "creator": {"@type": "Person", "name": "Ewa Tchórzewska"},
    "variableMeasured": ["evidence_decision_correct", "unsupported_claim_rate", "citation_support_accuracy", "pressure_induced_error", "appropriate_update", "excessive_abstention", "perceived_expertise"],
    "measurementTechnique": "2x2 within-item factorial, two conversation branches (pressure-only vs decisive new evidence) forked from the same first answer, blind double rating, mixed-effects logistic regression"
